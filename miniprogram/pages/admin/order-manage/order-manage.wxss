.tabs {
  display: flex;
  background: white;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}
.tab-item.active {
  color: #07c160;
  border-bottom-color: #07c160;
  font-weight: bold;
}
