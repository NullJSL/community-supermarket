<view class="container">
  <view class="tabs">
    <view class="tab-item {{currentStatus === '' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="">全部</view>
    <view class="tab-item {{currentStatus === 'PAID' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="PAID">待配送</view>
    <view class="tab-item {{currentStatus === 'DELIVERING' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="DELIVERING">配送中</view>
    <view class="tab-item {{currentStatus === 'COMPLETED' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="COMPLETED">已完成</view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="empty-tip">暂无订单</view>

  <view class="card" wx:for="{{orders}}" wx:key="id">
    <view class="flex-between" style="margin-bottom:16rpx;">
      <text style="font-size:24rpx;color:#999;">{{item.orderNo}}</text>
      <text style="color:#07c160;font-size:26rpx;">{{item.status}}</text>
    </view>
    <view wx:for="{{item.items}}" wx:for-item="oi" wx:key="id" style="font-size:28rpx;padding:4rpx 0;">
      {{oi.productName}} x{{oi.quantity}}
    </view>
    <view class="flex-between" style="margin-top:16rpx;">
      <text class="price">¥{{item.totalAmount}}</text>
      <view style="display:flex;gap:16rpx;">
        <view wx:if="{{item.status === 'PAID'}}" class="btn-primary" style="font-size:24rpx;padding:8rpx 24rpx;"
              bindtap="updateStatus" data-id="{{item.id}}" data-status="DELIVERING">开始配送</view>
        <view wx:if="{{item.status === 'DELIVERING'}}" class="btn-primary" style="font-size:24rpx;padding:8rpx 24rpx;"
              bindtap="updateStatus" data-id="{{item.id}}" data-status="COMPLETED">完成</view>
      </view>
    </view>
  </view>
</view>
