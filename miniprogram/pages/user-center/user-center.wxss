.user-card {
  text-align: center;
  padding: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
}

.user-role {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  background: #07c160;
  color: white;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.login-prompt {
  padding: 40rpx;
  color: #07c160;
  font-size: 32rpx;
}

.menu-title {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
}

.logout-btn {
  text-align: center;
  color: #e64340;
  margin-top: 40rpx;
  padding: 24rpx;
  font-size: 30rpx;
}
