.detail-img {
  width: 100%;
  height: 600rpx;
}

.detail-info {
  margin-top: -40rpx;
  position: relative;
  z-index: 1;
}

.detail-price {
  margin-bottom: 16rpx;
}

.detail-price .price {
  font-size: 44rpx;
}

.original-price {
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.detail-name {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.detail-meta {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: #999;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.1);
  gap: 20rpx;
}

.quantity-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  background: #f5f5f5;
  text-align: center;
  line-height: 48rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.qty-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
}

.bottom-bar .btn-outline,
.bottom-bar .btn-primary {
  flex: 1;
}
