<view class="container" wx:if="{{order}}">
  <!-- 状态 -->
  <view class="status-card card">
    <text class="status-text">{{order.status === 'PAID' ? '待配送' : order.status === 'DELIVERING' ? '配送中' : order.status === 'COMPLETED' ? '已完成' : order.status === 'CANCELLED' ? '已取消' : '待付款'}}</text>
    <text class="order-no-text">订单号：{{order.orderNo}}</text>
  </view>

  <!-- 配送信息 -->
  <view class="card">
    <text class="section-title">配送信息</text>
    <view class="info-row"><text class="label">地址：</text><text>{{order.deliveryAddress}}</text></view>
    <view class="info-row"><text class="label">电话：</text><text>{{order.deliveryPhone}}</text></view>
    <view class="info-row" wx:if="{{order.remark}}"><text class="label">备注：</text><text>{{order.remark}}</text></view>
    <view class="info-row" wx:if="{{order.deliveryStatus}}">
      <text class="label">配送状态：</text>
      <text>{{order.deliveryStatus === 'PENDING' ? '待取货' : order.deliveryStatus === 'PICKING' ? '取货中' : order.deliveryStatus === 'DELIVERING' ? '配送中' : '已送达'}}</text>
    </view>
  </view>

  <!-- 商品清单 -->
  <view class="card">
    <text class="section-title">商品清单</text>
    <view class="order-item-row" wx:for="{{order.items}}" wx:key="id">
      <text class="item-name">{{item.productName}}</text>
      <text class="item-qty">x{{item.quantity}}</text>
      <text class="item-price price">¥{{item.subtotal}}</text>
    </view>
    <view class="total-row">
      <text>订单总计：</text>
      <text class="price" style="font-size: 36rpx;">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="action-bar" wx:if="{{order.status === 'PAID' || order.status === 'PENDING'}}">
    <view class="btn-outline" bindtap="cancelOrder" style="flex:1;">取消订单</view>
  </view>
</view>
