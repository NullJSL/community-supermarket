<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品" confirm-type="search" bindinput="onSearch" />
  </view>

  <!-- 分类导航 -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-item {{currentCategory === null ? 'active' : ''}}"
          bindtap="onCategoryTap" data-id="{{null}}">全部</view>
    <view wx:for="{{categories}}" wx:key="id"
          class="category-item {{currentCategory === item.id ? 'active' : ''}}"
          bindtap="onCategoryTap" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <!-- 商品列表 -->
  <view class="product-grid">
    <view class="product-card" wx:for="{{products}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image class="product-img" src="{{item.imageUrl || '/static/images/default-product.png'}}" mode="aspectFill" />
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <view class="product-bottom">
          <text class="price">¥{{item.price}}</text>
          <text class="product-unit">/{{item.unit}}</text>
        </view>
        <view class="add-btn" catchtap="addToCart" data-product="{{item}}">+</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!hasMore && products.length > 0}}" class="empty-tip">没有更多了</view>
  <view wx:if="{{products.length === 0 && !loading}}" class="empty-tip">暂无商品</view>
</view>
