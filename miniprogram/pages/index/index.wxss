.search-bar {
  padding: 20rpx;
  background: white;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.search-input {
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.category-item.active {
  background: #07c160;
  color: white;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 48%;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.product-img {
  width: 100%;
  height: 300rpx;
}

.product-info {
  padding: 16rpx;
  position: relative;
}

.product-name {
  font-size: 28rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 72rpx;
}

.product-bottom {
  margin-top: 12rpx;
}

.product-unit {
  font-size: 24rpx;
  color: #999;
}

.add-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: #07c160;
  color: white;
  text-align: center;
  line-height: 48rpx;
  border-radius: 50%;
  font-size: 36rpx;
}
