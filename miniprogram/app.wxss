page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 20rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #e64340;
  font-weight: bold;
}

.btn-primary {
  background-color: #07c160;
  color: white;
  border-radius: 10rpx;
  text-align: center;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
}

.btn-outline {
  border: 1rpx solid #07c160;
  color: #07c160;
  border-radius: 10rpx;
  text-align: center;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
}

.card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
  font-size: 30rpx;
}
